# Served by the VPS. Deployed together with the built site (copied from the site-build branch).
{
	# Registers the HTTPS certificate account. With an email set, Caddy can also use ZeroSSL
	# when Let's Encrypt refuses (e.g. its weekly limit per domain).
	email iamprathameshashra@gmail.com
}

www.prathameshashra.com {
	redir https://prathameshashra.com{uri} permanent
}

prathameshashra.com {
	root * /var/www/site

	# One URL per page: /work/spontaa/ redirects to /work/spontaa.
	@slash path_regexp slash ^(.+)/$
	redir @slash {re.slash.1}{?query} permanent

	# Hashed bundles and fonts never change. Images load straight from cache (refreshed in the
	# background), so the hero's screenshot tiles never flash empty on reload. Pages always
	# revalidate, so a deploy shows up at once and never points at a bundle that's gone.
	@immutable path /assets/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@media path *.avif *.jpg *.png *.svg *.webmanifest
	header @media Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
	@pages not path /assets/* /fonts/* *.avif *.jpg *.png *.svg *.webmanifest
	header @pages Cache-Control "no-cache"

	# The CSP hash is the inline theme script in index.html; scripts/prerender.mjs fails the build
	# if the two drift apart. Outside origins: PostHog (analytics.ts) and Unsplash photos (CasePage.tsx).
	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-7AbUDcYKLNYlAacbhV4vwGh78E7f1KN3l/DyemadXnw=' https://eu-assets.i.posthog.com; connect-src 'self' https://eu.i.posthog.com https://eu-assets.i.posthog.com; img-src 'self' data: blob: https://images.unsplash.com; style-src 'self' 'unsafe-inline'; font-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# This config ships inside the build (for the server to sync); don't serve it.
	handle /server/* {
		error 404
	}
	# Prerendered routes live at /work/<id>.html etc. (scripts/prerender.mjs). Every text file has
	# .br and .gz twins (scripts/compress.mjs); Caddy sends the one the browser accepts.
	# Anything that isn't a file is a 404 (so /.well-known/ checks and crawlers get honest answers).
	handle {
		# {path}.html first: /side-quests is both a page and a folder of quest pages.
		try_files {path}.html {path}
		file_server {
			precompressed br gzip
		}
	}
	handle_errors 404 {
		rewrite * /404.html
		file_server {
			precompressed br gzip
		}
	}
}
