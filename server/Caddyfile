# Served by the VPS. Deployed together with the built site (copied from the site-build branch).
{
	# Registers the HTTPS certificate account. With an email set, Caddy can also use ZeroSSL
	# when Let's Encrypt refuses (e.g. its weekly limit per domain).
	email iamprathameshashra@gmail.com
}

www.prathameshashra.com {
	redir https://prathameshashra.com{uri} permanent
}

prathameshashra.com {
	root * /var/www/site
	encode zstd gzip
	# Hashed bundles and fonts never change. Images load straight from cache (refreshed in the
	# background), so the hero's screenshot tiles never flash empty on reload. Pages always
	# revalidate, so a deploy shows up at once and never points at a bundle that's gone.
	@immutable path /assets/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@media path *.jpg *.png *.svg *.webmanifest
	header @media Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
	@pages not path /assets/* /fonts/* *.jpg *.png *.svg *.webmanifest
	header @pages Cache-Control "no-cache"
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	# This config ships inside the build (for the server to sync); don't serve it.
	handle /server/* {
		respond 404
	}
	# Unknown /.well-known/ files must 404; serving the app's HTML there breaks agent and crawler checks.
	handle /.well-known/* {
		file_server
	}
	# Prerendered routes live at /work/<id>.html etc. (scripts/prerender.mjs); anything else gets the app shell.
	handle {
		# {path}.html first: /side-quests is both a page and a folder of quest pages.
		try_files {path}.html {path} /index.html
		file_server
	}
}
