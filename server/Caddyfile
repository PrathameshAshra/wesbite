# Served by the VPS. Deployed together with the built site (copied from the site-build branch).
{
	# Registers the HTTPS certificate account. With an email set, Caddy can also use ZeroSSL
	# when Let's Encrypt refuses (e.g. its weekly limit per domain).
	email prathameshedu@gmail.com
}

www.prathameshashra.com {
	redir https://prathameshashra.com{uri} permanent
}

prathameshashra.com {
	root * /var/www/site
	encode zstd gzip
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /fonts/* Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	try_files {path} /index.html
	file_server
}
