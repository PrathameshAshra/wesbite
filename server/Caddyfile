# Served by the VPS. Deployed together with the built site (copied from the site-build branch).
{
	# Registers the HTTPS certificate account. With an email set, Caddy can also use ZeroSSL
	# when Let's Encrypt refuses (e.g. its weekly limit per domain).
	email prathameshedu@gmail.com
}

www.prathameshashra.com {
	redir https://prathameshashra.com{uri} permanent
}

prathameshashra.com {
	root * /var/www/site
	encode zstd gzip
	# Hashed bundles and fonts never change; everything else (pages, images) revalidates, so a
	# deploy shows up at once and no page points at a bundle that no longer exists.
	@immutable path /assets/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@mutable not path /assets/* /fonts/*
	header @mutable Cache-Control "no-cache"
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	# Unknown /.well-known/ files must 404; serving the app's HTML there breaks agent and crawler checks.
	handle /.well-known/* {
		file_server
	}
	# Prerendered routes live at /work/<id>.html etc. (scripts/prerender.mjs); anything else gets the app shell.
	handle {
		try_files {path} {path}.html /index.html
		file_server
	}
}
